<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.anlohse.datadam</groupId><artifactId>datadam-spring-data-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>datadam-demo</artifactId>
  <properties><maven.deploy.skip>true</maven.deploy.skip></properties>
  <dependencies>
    <dependency><groupId>com.anlohse.datadam</groupId><artifactId>datadam-spring-boot-starter</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-console</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <testResources>
      <testResource><directory>src/test/resources</directory></testResource>
      <testResource><directory>${project.basedir}/../config</directory><includes><include>test-images.properties</include></includes></testResource>
    </testResources>
    <plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins>
  </build>
  <profiles><profile><id>integration</id><build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
    <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
  </plugin></plugins></build></profile>
  <profile><id>example-failures</id><build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
    <configuration><reportsDirectory>${project.build.directory}/example-failures/failsafe-reports</reportsDirectory></configuration>
  </plugin></plugins></build></profile>
  <profile><id>performance</id><build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
    <configuration><reportsDirectory>${project.build.directory}/performance/failsafe-reports</reportsDirectory></configuration>
  </plugin></plugins></build></profile></profiles>
</project>
