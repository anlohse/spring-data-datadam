diff --git a/tests/json_test.cpp b/tests/json_test.cpp
index a5076da..e63e0ee 100644
--- a/tests/json_test.cpp
+++ b/tests/json_test.cpp
@@ -446,3 +446,20 @@ TEST_F(JsonIndexes, Unique) {
   EXPECT_EQ(text({"RENAME", "acct:2", "acct:3"}), "OK");  // its own value moves with it
   EXPECT_EQ(run({"IDX.GET", "emails", "a@x"}).items[0].text, "acct:3");
 }
+
+TEST_F(JsonIndexes, TypedReturnPreservesNullStringsArraysAndAbsence) {
+  ASSERT_EQ(text({"JSON.SET", "p:1", "$", R"({"age":20,"name":"null","optional":null,"tags":["a","b"]})"}), "OK");
+  ASSERT_EQ(text({"IDX.CREATE", "p", "ON", "JSON", "PREFIX", "1", "p:", "SCHEMA", "$.age", "AS", "age", "NUMERIC"}), "OK");
+  ready("p");
+  auto result = run({"IDX.QUERY", "p", "RETURNJSON", "5", "$.name", "$.optional", "$.tags", "$.missing", "age"});
+  ASSERT_EQ(result.items.size(), 2);
+  const auto& fields = result.items[1].items;
+  ASSERT_EQ(fields.size(), 8);
+  EXPECT_EQ(fields[1].text, "\"null\"");
+  EXPECT_EQ(fields[3].text, "null");
+  EXPECT_EQ(fields[5].text, "[\"a\",\"b\"]");
+  EXPECT_EQ(fields[7].text, "20");
+  auto old = run({"IDX.QUERY", "p", "RETURN", "1", "$.name"});
+  EXPECT_EQ(old.items[1].items[1].text, "null");
+  EXPECT_TRUE(run({"IDX.QUERY", "p", "RETURN", "1", "age", "RETURNJSON", "1", "age"}).error);
+}
diff --git a/tests/search_test.cpp b/tests/search_test.cpp
index 9baca2b..7952232 100644
--- a/tests/search_test.cpp
+++ b/tests/search_test.cpp
@@ -381,3 +381,17 @@ TEST_F(Search, CompoundIndexesWithSeveralValues) {
   text({"JSON.ARRAPPEND", "post:2", "$.tags", R"("cpp")"});
   EXPECT_EQ(text({"IDX.COUNT", "posts", "tag", "=", "cpp"}), "2");
 }
+
+TEST_F(Search, TypedJsonReturnSupportsAliasesWithoutChangingReturn) {
+  ASSERT_EQ(text({"JSON.SET", "p:1", "$", R"({"age":20,"name":"null","optional":null,"tags":["a","b"]})"}), "OK");
+  ASSERT_EQ(text({"FT.CREATE", "p", "ON", "JSON", "PREFIX", "1", "p:", "SCHEMA", "$.age", "AS", "age", "NUMERIC"}), "OK");
+  ready("p");
+  auto result = run({"FT.SEARCH", "p", "*", "RETURNJSON", "7", "$.name", "AS", "display", "$.optional", "$.tags", "$.missing", "age"});
+  ASSERT_EQ(result.items.size(), 3);
+  const auto& fields = result.items[2].items;
+  ASSERT_EQ(fields.size(), 8);
+  EXPECT_EQ(fields[0].text, "display"); EXPECT_EQ(fields[1].text, "\"null\"");
+  EXPECT_EQ(fields[3].text, "null"); EXPECT_EQ(fields[5].text, "[\"a\",\"b\"]"); EXPECT_EQ(fields[7].text, "20");
+  EXPECT_EQ(run({"FT.SEARCH", "p", "*", "RETURN", "1", "$.name"}).items[2].items[1].text, "null");
+  EXPECT_TRUE(run({"FT.SEARCH", "p", "*", "RETURNJSON", "1", "age", "RETURN", "1", "age"}).error);
+}
